{
  "firestore": {
    "rules": "firebase/firestore.rules",
    "indexes": "firebase/firestore.indexes.json"
  },
  "hosting": {
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  },
  "emulators": {
    "auth": {
      "port": 9095,
      "host": "0.0.0.0"
    },
    "firestore": {
      "port": 8085,
      "host": "0.0.0.0"
    },
    "ui": {
      "enabled": true,
      "port": 4000,
      "host": "0.0.0.0"
    },
    "singleProjectMode": true,
    "functions": {
      "port": 5001,
      "host": "127.0.0.1"
    }
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "sanjose",
      "ignore": [
        "node_modules",
        ".git",
        "*.log"
      ]
    }
  ]
}